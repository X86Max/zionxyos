NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Use your real HTTPS origin in production. localhost HTTP is allowed only for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required in production: random secret, at least 24 characters.
RATE_LIMIT_SALT=replace-with-a-long-random-secret

# Optional deployment/update integration. Keep these server-side only.
VERCEL_DEPLOY_HOOK_URL=
# Comma-separated exact hostnames allowed for release manifests in production.
# Example: raw.githubusercontent.com,updates.example.com
ZIONXYOS_RELEASE_MANIFEST_ALLOWED_HOSTS=
ZIONXYOS_UPDATE_WEBHOOK_TOKEN=

# Required in production: random secret, at least 32 characters, used to sign password-recovery state/grants.
AUTH_RECOVERY_STATE_SECRET=replace-with-a-long-random-secret
